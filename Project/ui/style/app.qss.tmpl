@# app.qss.tmpl: the one source of app-light.qss and app-dark.qss.
@#
@# Edit this file or tokens.py, never the generated .qss files, then run
@#     python3 Project/ui/style/build_qss.py
@# and commit what you edited together with both regenerated stylesheets
@# (Project/tests/unit/test_qss_generated.py fails while one is stale).
@#
@#   ${role.name}   a colour from tokens.py, e.g. ${bg.surface}; an unknown role, or
@#                  a $ without the braces, stops the build
@#   @light         the lines up to the next @dark or @end are for the light theme only
@#   @dark          the lines up to the next @light or @end are for the dark theme only
@#   @end           back to lines both themes share
@#   @# ...         a template comment like this one
@#
@# A directive starts its line: an indented one stops the build.
@#
@# Both themes share every rule and every declaration: they differ only in token values
@# and in some comments.
@#
/*
@light
 * Rodent Refreshment Regulator - Light Theme
@dark
 * Rodent Refreshment Regulator - Dark Theme
@end
 *
 * Fluent 2 / WinUI layers (v2.1.0): a near-white page (the base layer) under white tab panes
 * (the content layer), one hairline stroke round every pane, card, box and table, Fluent's
 * resting shadow under the primary cards, rules between sections, teal accent. Every colour
 * is a role in Project/ui/style/tokens.py, and
 * Project/tests/unit/test_theme_contrast.py checks the pairs the UI draws, in both themes.
 *
 * Base colours come from the QPalette StyleManager builds from the same tokens (window,
 * text, fields, placeholders, alternate rows, selection, links). The rules below set
 * surfaces, borders and the colours that differ from those.
 */

/* ============================================
   GLOBAL DEFAULTS
   ============================================ */
* {
    font-family: "IBM Plex Sans", "SF Pro Display", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 13px;
    outline: none;
}

/* No universal QWidget background or colour: the window and dialogs paint the
   palette's Window (bg.page), and plain containers stay transparent, so a container
   inside a card shows the card. A `color` on any rule that matches an input would
   become its placeholder's colour too: at half alpha from Qt 5.15.12 (below 4.5:1), as
   typed text on the Pi's 5.15.8. Inputs take their text and placeholder colours from the
   palette. */

/* A scroll area's viewport and content widget fill themselves with the palette's
   Window, which would paint the page colour inside a card: they show what the scroll
   area sits on (the QScrollArea rule reaches its viewport). Stacked pages do too. */
QScrollArea, QScrollArea > QWidget > QWidget, QStackedWidget {
    background: transparent;
}

/* ============================================
   CARDS & ELEVATED SURFACES
   ============================================ */
QFrame#Card, QFrame[card="true"] {
    background: ${bg.surface};
    border: 1px solid ${border.subtle};
    border-radius: 8px;
    padding: 0;
}

/* An elevated card (ui.style.elevation.ElevatedMixin: the Profile and login cards, the Cages
   board, Controls, Schedule Queue, the schedule cards, the wizard's type cards) reserves room
   round its box for its shadow and paints the shadow there; the box above is drawn inside
   the room. build_qss.py writes the room from tokens.SHADOWS: the union of every recipe's
   reach, so a recipe can be swapped without moving a widget. */
QFrame[elevation="card"] {
    margin: ${elevation.card.margin};
}

/* A card's title, inside the card above a full-width rule (CardHeader + Divider in
   ui/components/card.py): the group-box title's type, now in the card it names */
QLabel#CardHeader {
    font-size: 14px;
    font-weight: 600;
    color: ${text.primary};
    padding: 12px 16px 10px 16px;
}

/* Logged-out login prompt. It stands where the Projects tab pane stands once logged in, so it
   is drawn as that pane: the content layer's fill and stroke, in both themes */
QWidget#LoginGatePrompt, QWidget#LoginGatePrompt QLabel {
    background-color: ${bg.pane};
}
QWidget#LoginGatePrompt {
    border: 1px solid ${border.subtle};
    border-radius: 8px;
}

/* Labels are transparent by default so they blend into whatever surface they
   sit on (e.g. Cards) rather than painting the page as a box.
   objectName-styled labels (banners, etc.) override this. */
QLabel {
    background: transparent;
}

/* ============================================
   TYPOGRAPHY HELPERS
   ============================================ */
QLabel#Headline {
    font-size: 24px;
    font-weight: 600;
    color: ${text.primary};
}
QLabel#Title {
    font-size: 18px;
    font-weight: 500;
    color: ${text.primary};
}
QLabel#Subtitle, QLabel#Subheader {
    font-size: 14px;
    font-weight: 400;
    color: ${text.secondary};
    padding: 4px 0;
}
QLabel#Caption {
    font-size: 11px;
    color: ${text.muted};
}

/* ============================================
   FORM INPUTS
   ============================================ */
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: ${bg.field};
    border: 1px solid ${border.control};
    border-radius: 4px;
    padding: 10px 12px;
    selection-background-color: ${bg.selected};
    selection-color: ${text.on-accent};
}
QComboBox { 
    min-height: 36px;
    padding-right: 28px;
    /* Use the classic popup that sizes to fit all items. With a stylesheet Qt
       switches to a scrollable popup whose height is computed from the font
       row height, not the styled (min-height + padding) row height, so the last
       item gets clipped behind a scroll arrow. */
    combobox-popup: 0;
}
QLineEdit:hover, QPlainTextEdit:hover, QTextEdit:hover, 
QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border-color: ${border.control.hover};
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, 
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 2px solid ${focus.ring};
    padding: 9px 11px;
    background: ${bg.field};
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background: ${bg.disabled};
    color: ${text.disabled};
    border-color: ${border.subtle};
}

/* Placeholder text is the palette's PlaceholderText (text.muted): no rule here. */

/* The Terminal: a read-only log that fills its tab pane, so the pane is its frame. No control
   boundary of its own (with it, the pane's stroke and the log's made a double edge), and no
   fill: it shows the pane. */
QPlainTextEdit#TerminalLog {
    background: transparent;
    border: none;
    padding: 10px 12px;
}
/* Tab reaches the log (it scrolls with the keys), so focus draws the focus stroke inside the
   pane's edge, round the pane's inner corners; the padding gives the 2px back, so the text
   does not move */
QPlainTextEdit#TerminalLog:focus {
    border: 2px solid ${focus.ring};
    border-radius: 7px;
    padding: 8px 10px;
}

/* ComboBox dropdown */
QComboBox::drop-down {
    border: none;
    width: 24px;
    padding-right: 8px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid ${text.secondary};
}
QComboBox QAbstractItemView {
    background: ${bg.surface};
    border: 1px solid ${border.subtle};
    border-radius: 8px;
    padding: 4px;
    selection-background-color: ${bg.selected};
    selection-color: ${text.on-accent};
}
QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 6px 10px;
    border-radius: 4px;
    color: ${text.primary};
}
QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background: ${bg.selected};
    color: ${text.on-accent};
}

/* SpinBox buttons */
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: transparent;
    border: none;
    width: 20px;
}

/* ============================================
   BUTTONS - Default
   ============================================ */
QPushButton {
    background: ${bg.surface};
    border: 1px solid ${border.control};
    border-radius: 4px;
    padding: 10px 20px;
    min-height: 40px;
    font-weight: 500;
    color: ${text.primary};
}
QPushButton:hover { 
    background: ${bg.hover};
    border-color: ${border.control.hover};
}
QPushButton:pressed {
    background: ${bg.pressed};
    border-color: ${border.control.hover};
}
QPushButton:disabled {
    background: ${bg.disabled};
    color: ${text.disabled};
    border-color: ${border.subtle};
}
QPushButton:focus {
    border: 2px solid ${focus.ring};
    padding: 9px 19px;
}

/* Compact buttons for tables */
QTableWidget QPushButton {
    padding: 6px 12px;
    min-height: 28px;
    max-height: 32px;
    font-size: 12px;
    border-radius: 4px;
}

/* Info Button - Circular help icon */
QPushButton#InfoButton {
    background-color: ${accent.fill};
    color: ${text.on-accent};
    border: none;
    border-radius: 12px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
    font-size: 14px;
    font-weight: 700;
}
QPushButton#InfoButton:hover {
    background-color: ${accent.fill.hover};
}
QPushButton#InfoButton:pressed {
    background-color: ${accent.fill.pressed};
}

QPushButton#CompactButton {
    padding: 8px 12px;
    min-height: 32px;
    max-height: 36px;
    font-size: 12px;
}

/* ============================================
   BUTTONS - Primary (Teal)
   ============================================ */
QPushButton[variant="primary"] {
    background: ${accent.fill};
    border: 1px solid ${accent.fill};
    color: ${text.on-accent};
    font-weight: 600;
}
QPushButton[variant="primary"]:hover {
    background: ${accent.fill.hover};
    border-color: ${accent.fill.hover};
}
QPushButton[variant="primary"]:pressed {
    background: ${accent.fill.pressed};
    border-color: ${accent.fill.pressed};
}
/* Greyed out like every other disabled button */
QPushButton[variant="primary"]:disabled {
    background: ${bg.disabled};
    border-color: ${border.subtle};
    color: ${text.disabled};
}
QPushButton[variant="primary"]:focus {
    border: 2px solid ${focus.ring.primary};
}

/* ============================================
   BUTTONS - Danger
   ============================================ */
QPushButton[variant="danger"] {
    background: ${danger.fill};
    border: 1px solid ${danger.fill};
    color: ${text.on-danger};
    font-weight: 600;
}
QPushButton[variant="danger"]:hover {
    background: ${danger.fill.hover};
    border-color: ${danger.fill.hover};
}
QPushButton[variant="danger"]:pressed {
    background: ${danger.fill.pressed};
    border-color: ${danger.fill.pressed};
}
/* Greyed out like every other disabled button: the red alone must not say
   "press me" when the control is unavailable (CLOSE ALL RELAYS and Log Out
   while a schedule runs, Close Master while the master is closed). */
QPushButton[variant="danger"]:disabled {
    background: ${bg.disabled};
    border-color: ${border.subtle};
    color: ${text.disabled};
}

/* ============================================
   TABS
   ============================================ */
/* The content layer: a tab pane is the lighter surface its tabs open onto (WinUI's base and
   content layers; the page is the base). One stroke, as WinUI's content frame. Its top-left
   corner is square, as in WinUI's TabView: the first tab sits on it, and when that tab is
   selected its left edge and the pane's are one straight line (a rounded corner bent it
   into a small arc). The other three corners keep the container radius. */
QTabWidget::pane {
    border: 1px solid ${border.subtle};
    border-radius: 8px;
    border-top-left-radius: 0;
    background: ${bg.pane};
    margin-top: -1px;
}
/* Unselected tabs lie flat on the base layer, as WinUI's TabView draws them: no outline. The
   1px border stays, transparent, so selecting a tab moves nothing. */
QTabBar::tab {
    background: ${bg.rail};
    border: 1px solid transparent;
    border-bottom: none;
    padding: 8px 16px;
    min-width: 70px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 2px;
    font-size: 12px;
    font-weight: 500;
    color: ${text.secondary};
}
/* An unselected tab stops 1px short of the pane, so the pane's top stroke runs under it
   (the padding gives the pixel back). Between two unselected tabs a 1px separator, inset a
   quarter of the tab's height top and bottom, keeps their boundary: WinUI TabView's
   TabSeparator. The tab before the selected one, and the last, need none. Square corners:
   a rounded one would draw a stub of the separator at the tab's top. */
QTabBar::tab:!selected {
    margin-bottom: 1px;
    padding-bottom: 7px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-right-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 transparent, stop: 0.25 transparent, stop: 0.2501 ${border.subtle}, stop: 0.75 ${border.subtle}, stop: 0.7501 transparent, stop: 1 transparent);
}
/* As in TabView, a tab under the pointer or pressed shows no separator of its own */
QTabBar::tab:!selected:next-selected, QTabBar::tab:!selected:last,
QTabBar::tab:!selected:hover, QTabBar::tab:!selected:pressed {
    border-right-color: transparent;
}
QTabBar::tab:hover {
    background: ${bg.rail.hover};
    color: ${text.primary};
}
/* The selected tab joins its pane, and a 3px accent bar on top marks it: the bar is
   3:1 or more against the pane and the rail, so the state is not carried by a
   colour step alone. The bar takes 2px of the top padding, so no tab moves. */
QTabBar::tab:selected {
    background: ${bg.pane};
    border-color: ${border.subtle};
    border-bottom-color: ${bg.pane};
    border-top: 3px solid ${accent.indicator};
    padding-top: 6px;
    color: ${text.primary};
    font-weight: 600;
}
/* Ensure tab bar doesn't scroll prematurely */
QTabBar {
    qproperty-expanding: false;
}
/* A tab widget inside a pane or a card (Settings' sub-tabs, the Cages HAT tabs) is a Fluent
   TabList: a strip over a rule, not a second box. Its tabs are transparent, so they show
   the pane or card they sit on, with no separators; the selected one carries the 3px bar at
   its foot, on the rule, and the bar takes 3px of the padding, so no tab moves. */
QTabWidget QTabWidget::pane {
    background: transparent;
    border: none;
    border-top: 1px solid ${border.divider};
    border-radius: 0;
}
QTabWidget QTabWidget > QTabBar::tab {
    background: transparent;
}
QTabWidget QTabWidget > QTabBar::tab:!selected {
    border-right-color: transparent;
}
QTabWidget QTabWidget > QTabBar::tab:selected {
    background: transparent;
    border-color: transparent;
    border-top: 1px solid transparent;
    border-bottom: 3px solid ${accent.indicator};
    padding-top: 8px;
    padding-bottom: 5px;
}

/* ============================================
   TABLES
   ============================================ */
/* The header widget and its corner paint the palette's Window, not the section rule:
   transparent, they show the table's own surface. */
QHeaderView {
    background: transparent;
}
/* No band under the column titles: a rule (Fluent's TableHeader), one step stronger than
   the row rules below it */
QHeaderView::section {
    background: transparent;
    border: none;
    border-bottom: 1px solid ${border.subtle};
    padding: 12px 16px;
    font-weight: 600;
    color: ${text.secondary};
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.5px;
}
QTableCornerButton::section {
    background: transparent;
    border: none;
    border-bottom: 1px solid ${border.subtle};
}
QTableView, QTableWidget {
    background: ${bg.surface};
    alternate-background-color: ${bg.alt};
    border: 1px solid ${border.subtle};
    border-radius: 8px;
    gridline-color: ${border.divider};
    selection-background-color: ${bg.selected};
    selection-color: ${text.on-accent};
    color: ${text.primary};
    /* Each row is ruled once, by its item's bottom rule below: no grid as well (it drew a
       second rule under every row and 1px slits between zebra cells) */
    qproperty-showGrid: false;
}
QTableView::item, QTableWidget::item {
    padding: 12px 16px;
    border-bottom: 1px solid ${border.divider};
}
/* Hover first: a selected row under the pointer keeps the selection colours. */
QTableView::item:hover, QTableWidget::item:hover {
    background: ${bg.hover};
}
QTableView::item:selected, QTableWidget::item:selected {
    background: ${bg.selected};
    color: ${text.on-accent};
}

/* A table or a list inside a group box or a card is content: the box frames it, so it
   draws no outline of its own */
QGroupBox QTableView, QGroupBox QTableWidget, QGroupBox QListWidget,
QFrame#Card QTableView, QFrame#Card QTableWidget, QFrame#Card QListWidget {
    border: none;
    border-radius: 0;
}

/* Animals tab: the "Last schedule delivered amount" cell of a run that ended short
   (Stopped, Incomplete, Interrupted) is filled with alertFill and written in alertText,
   bold, by AnimalsTab's delegate: the same bright red in both themes, with white text
   at 4.83:1. The cell's text starts with its status word, so the red is not the only
   cue. */
QWidget#AnimalsTab {
    qproperty-alertFill: ${danger.alert};
    qproperty-alertText: ${danger.on-alert};
}

/* ============================================
   CALENDAR POPUP
   ============================================ */
/* A date field's calendar fills its navigation bar with the palette's Highlight and
   writes the month and year in HighlightedText: a solid teal band. The bar is the inset
   surface instead, the page colour it had before v2.1.0, under body text. Its days are
   a table (the rules above and the palette: Base, AlternateBase for the weekday row,
   Highlight for the chosen day); theme.py writes the weekend in text.weekend. */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: ${bg.inset};
}
QCalendarWidget QToolButton {
    color: ${text.primary};
}

/* ============================================
   PROGRESS BARS
   ============================================ */
/* The groove is bg.track, which is the page's colour: a 1px outline shows the bar's whole
   length where it sits on the page (the calibration wizard's run, the Stopping dialog) as
   well as on a card. The outline takes 2px of the 8px height, so the bar keeps its size. */
QProgressBar {
    border: 1px solid ${border.subtle};
    border-radius: 8px;
    text-align: center;
    background: ${bg.track};
    min-height: 6px;
    max-height: 6px;
}
QProgressBar::chunk {
    background: ${accent.indicator};
    border-radius: 8px;
}

/* ============================================
   GROUP BOXES (Cards)
   ============================================ */
QGroupBox {
    background: ${bg.surface};
    border: 1px solid ${border.subtle};
    border-radius: 8px;
    margin-top: 24px;
    margin-bottom: 8px;
    padding: 24px 20px 20px 20px;
    color: ${text.primary};
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px;
    top: 8px;
    padding: 0 8px;
    color: ${text.primary};
    font-weight: 600;
    font-size: 14px;
    background: transparent;
}

/* A group box inside a group box or a card is a section, not a second box: its title over
   a 1px rule (Fluent's Divider), on the box it sits in */
QGroupBox QGroupBox, QFrame#Card QGroupBox, QFrame[card="true"] QGroupBox {
    background: transparent;
    border: none;
    border-top: 1px solid ${border.divider};
    border-radius: 0;
    margin-top: 24px;
    padding: 16px 0 0 0;
}
QGroupBox QGroupBox::title, QFrame#Card QGroupBox::title, QFrame[card="true"] QGroupBox::title {
    left: 0;
    top: 4px;
    padding: 0;
    color: ${text.secondary};
    font-weight: 600;
    font-size: 12px;
}

/* ============================================
   LISTS
   ============================================ */
QListWidget {
    background: ${bg.surface};
    alternate-background-color: ${bg.alt};
    border: 1px solid ${border.subtle};
    border-radius: 8px;
    padding: 8px;
    color: ${text.primary};
}
QListWidget::item { 
    padding: 10px 12px;
    border-radius: 4px;
    margin: 2px 0;
}
QListWidget::item:hover {
    background: ${bg.hover};
}
QListWidget::item:selected {
    background: ${bg.selected};
    color: ${text.on-accent};
    font-weight: 500;
}

/* ============================================
   SCROLLBARS (Minimal)
   ============================================ */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px;
}
QScrollBar::handle:vertical {
    background: ${border.control};
    border-radius: 4px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover {
    background: ${border.control.hover};
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 2px 4px;
}
QScrollBar::handle:horizontal {
    background: ${border.control};
    border-radius: 4px;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover {
    background: ${border.control.hover};
}
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page { 
    background: transparent;
    width: 0; 
    height: 0; 
}

/* ============================================
   DROP AREAS
   ============================================ */
QWidget#DropArea[state="idle"] {
    background: ${bg.surface};
    border: 2px dashed ${border.control};
    border-radius: 8px;
}
QWidget#DropArea[state="drag"] {
    background: ${accent.tint};
    border: 2px solid ${accent.indicator};
    border-radius: 8px;
}

/* ============================================
   STATUS INDICATORS
   ============================================ */
QLabel[variant="warning"] {
    background: ${warning.tint};
    color: ${warning.on-tint};
    padding: 12px 16px;
    border-radius: 4px;
    border-left: 4px solid ${warning.indicator};
}
QLabel[variant="success"] {
    background: ${success.tint};
    color: ${success.on-tint};
    padding: 12px 16px;
    border-radius: 4px;
    border-left: 4px solid ${success.indicator};
}
QLabel[variant="error"] {
    background: ${danger.tint};
    color: ${danger.on-tint};
    padding: 12px 16px;
    border-radius: 4px;
    border-left: 4px solid ${danger.indicator};
}
QLabel[variant="info"] {
    background: ${info.tint};
    color: ${info.on-tint};
    padding: 12px 16px;
    border-radius: 4px;
    border-left: 4px solid ${info.indicator};
}

/* ============================================
   USER TAB STYLES
   ============================================ */
QLabel#InfoBanner {
    background: ${accent.tint};
    color: ${text.accent};
    padding: 12px 16px;
    border-radius: 4px;
    border-left: 4px solid ${accent.indicator};
}
QLabel#ProfileWelcome {
    font-size: 18px;
    font-weight: 600;
    padding: 8px 0;
    color: ${text.primary};
}
QLabel#LinkLabel {
    color: ${text.link};
    font-size: 12px;
}
QLabel#LinkLabel:hover {
    text-decoration: underline;
}

/* ============================================
   HELP TEXT
   ============================================ */
QLabel#HelpText {
    color: ${text.secondary};
    font-size: 12px;
    padding: 4px 0;
    line-height: 1.5;
}

/* ============================================
   SETTINGS
   ============================================ */
/* A group box's one-line description (General > User Mode) */
QLabel#GroupDescription {
    color: ${text.secondary};
    font-size: 11px;
}

/* General > Slack Integration > Status: the colour of the last message's fate, which its
   words also give (Delivered at, Failed at, Status unknown) */
QLabel#SlackStatus {
    color: ${text.muted};
    padding: 6px;
    border-radius: 4px;
}
QLabel#SlackStatus[status="ok"] {
    color: ${success.text};
}
QLabel#SlackStatus[status="warn"] {
    color: ${warning.text};
}

/* ============================================
   PRIMING STATUS
   ============================================ */
QLabel#StatusLabel {
    border-radius: 4px;
    padding: 10px 16px;
    font-weight: 600;
    font-size: 13px;
}
QLabel#StatusLabel[status="closed"] {
    background: ${bg.inset};
    color: ${text.secondary};
}
QLabel#StatusLabel[status="open"] {
    background: ${accent.fill};
    color: ${text.on-accent};
}

/* ============================================
   FORM LAYOUTS
   ============================================ */
QGroupBox QLabel {
    background: transparent;
    color: ${text.primary};
}
QFormLayout > QLabel {
    min-width: 160px;
    padding-right: 12px;
    color: ${text.secondary};
    font-weight: 500;
}

/* ============================================
   SCHEDULES HUB
   ============================================ */
QLabel#SchedulesHubTitle {
    font-size: 16px;
    font-weight: 700;
    color: ${text.primary};
}

/* The header's buttons are smaller than the app's. Their own border (1px, or none)
   outranks QPushButton:focus, so focus does not thicken it, as before v2.1.0. */
/* Select is a default button. It reads Cancel in select mode, in the danger tint. */
QPushButton#SchedulesHubSelect {
    border: 1px solid ${border.control};
    border-radius: 4px;
    padding: 5px 12px;
    font-weight: 500;
    font-size: 11px;
}
QPushButton#SchedulesHubSelect[selecting="true"] {
    background: ${danger.tint};
    border-color: ${danger.tint.strong};
    color: ${danger.on-tint};
}
QPushButton#SchedulesHubSelect[selecting="true"]:hover {
    background: ${danger.tint.strong};
}
/* Edit Schedule, Delete Selected, + New Schedule and the empty state's Create Schedule
   take their colours from QPushButton[variant="primary"] and [variant="danger"] */
QPushButton#SchedulesHubEdit, QPushButton#SchedulesHubDelete, QPushButton#SchedulesHubNew {
    border: none;
    border-radius: 4px;
    padding: 5px 12px;
    font-size: 11px;
}
QPushButton#SchedulesHubEdit, QPushButton#SchedulesHubDelete {
    font-weight: 500;
}
QPushButton#SchedulesHubNew {
    font-weight: 600;
}
QPushButton#SchedulesHubCreate {
    border: none;
    border-radius: 4px;
    padding: 8px 20px;
    font-weight: 600;
}

/* The search field keeps its 1px frame when focused, with the focus colour */
QLineEdit#SchedulesHubSearch {
    border: 1px solid ${border.control};
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
    background: ${bg.field};
}
QLineEdit#SchedulesHubSearch:focus {
    border-color: ${focus.ring};
}

QLabel#SchedulesHubEmptyTitle {
    font-size: 14px;
    font-weight: 600;
    color: ${text.secondary};
}
QLabel#SchedulesHubEmptyText {
    font-size: 12px;
    color: ${text.muted};
}

/* A schedule card. In select mode a selected card (selected="true") is tinted, with a
   2px border; its rule comes after :hover, so it keeps that look under the pointer. */
QFrame#ScheduleCard {
    background: ${bg.surface};
    border: 1px solid ${border.subtle};
    border-radius: 8px;
}
/* Under the pointer a schedule card lifts (its shadow, ui.style.elevation) and its edge
   darkens; its fill stays white, so the lift is not mixed with a grey hover */
QFrame#ScheduleCard:hover {
    background: ${bg.surface};
    border-color: ${border.control.hover};
}
QFrame#ScheduleCard[selected="true"] {
    background: ${accent.tint};
    border: 2px solid ${accent.indicator};
}
QLabel#ScheduleCardName {
    font-size: 13px;
    font-weight: 600;
    color: ${text.primary};
    background: transparent;
}
QLabel#ScheduleCardMeta {
    font-size: 11px;
    color: ${text.secondary};
    background: transparent;
}
QLabel#ScheduleCardHint {
    font-size: 9px;
    color: ${text.muted};
    background: transparent;
}
QLabel#ScheduleCardCreated {
    font-size: 9px;
    font-weight: 500;
    color: ${text.accent};
    background: transparent;
}
/* The delivery mode: Staggered in the accent, Instant in indigo; the word names it */
QLabel#ScheduleModeBadge {
    border-radius: 10px;
    font-weight: 600;
    font-size: 9px;
    padding: 3px 8px;
}
QLabel#ScheduleModeBadge[mode="staggered"] {
    background: ${accent.fill};
    color: ${text.on-accent};
}
QLabel#ScheduleModeBadge[mode="instant"] {
    background: ${instant.fill};
    color: ${text.on-instant};
}
/* A card's context menu: tighter than the app's menus, in their colours */
QMenu#ScheduleCardMenu {
    border-radius: 8px;
    padding: 4px;
}
QMenu#ScheduleCardMenu::item {
    padding: 8px 16px;
    border-radius: 4px;
}

/* ============================================
   SCHEDULE PROGRESS TRACKER
   ============================================ */

/* Header strip: flush with its pane on three sides, so a rule under it, not a box (a box
   drew a second hairline beside the pane's) */
QFrame#TrackerHeader {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid ${border.divider};
    border-radius: 0;
    padding: 12px;
}

QLabel#ScheduleTitle {
    font-size: 16px;
    font-weight: 600;
    color: ${text.primary};
    background: transparent;
}

QLabel#ElapsedTime {
    font-size: 14px;
    font-weight: 500;
    color: ${text.accent};
    background: ${accent.tint};
    padding: 6px 12px;
    border-radius: 16px;
}

QScrollArea#TrackerScrollArea {
    background-color: transparent;
    border: none;
}

/* Material Cards: one per animal */
QFrame#MaterialCard {
    background-color: ${bg.surface};
    border: 1px solid ${border.subtle};
    border-radius: 8px;
    padding: 0;
}
/* A QLabel is a QFrame. Before v2.1.0 the card's own `QFrame {...}` sheet also gave every
   label in it a 1px border: it drew a box around each, and QLabel indents the text of a
   framed label by half an "x". The border stays, transparent, so no label moves; removing
   it is a layout change for later. */
QFrame#MaterialCard QLabel {
    border: 1px solid transparent;
}

QLabel#CardTitle {
    font-size: 15px;
    font-weight: 600;
    color: ${text.primary};
    background: transparent;
}

QLabel#TrackerAnimal {
    font-size: 13px;
    font-weight: 600;
    color: ${text.primary};
}

QLabel#CageBadge {
    background-color: ${accent.fill};
    color: ${text.on-accent};
    padding: 5px 10px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 11px;
}

/* The animal's progress. The bar writes its value inside it in one colour, over the
   groove and the fill alike: each fill is a shade text.primary reads on (tokens.py,
   progress.*). A complete or failed bar keeps its state (state="complete"|"failed"). */
QProgressBar#TrackerProgress {
    border: 1px solid ${border.subtle};
    border-radius: 11px;
    background: ${bg.track};
    text-align: center;
    font-size: 11px;
    font-weight: 500;
    color: ${text.primary};
    /* 8px inside its outline: 10px tall, as before v2.1.0 */
    min-height: 8px;
    max-height: 8px;
}
QProgressBar#TrackerProgress::chunk {
    border-radius: 10px;
    background: ${progress.fill};
}
QProgressBar#TrackerProgress[state="complete"] {
    background: ${success.tint};
}
QProgressBar#TrackerProgress[state="complete"]::chunk {
    background: ${progress.fill.complete};
}
QProgressBar#TrackerProgress[state="failed"] {
    background: ${danger.tint};
}
QProgressBar#TrackerProgress[state="failed"]::chunk {
    background: ${progress.fill.failed};
}

QLabel#VolumeLabel {
    font-size: 12px;
    font-weight: 600;
    color: ${text.primary};
    background: transparent;
}

/* The status word: muted and regular until the card's first update, then bold in its
   status's colour. Waiting, and a word with no colour of its own (Incomplete: "other"),
   stay muted. */
QLabel#DeliveryStatus {
    font-size: 11px;
    color: ${text.muted};
}
QLabel#DeliveryStatus[status="waiting"],
QLabel#DeliveryStatus[status="other"] {
    font-weight: 600;
}
QLabel#DeliveryStatus[status="delivering"] {
    font-weight: 600;
    color: ${text.accent};
}
QLabel#DeliveryStatus[status="paused"] {
    font-weight: 600;
    color: ${warning.text};
}
QLabel#DeliveryStatus[status="complete"] {
    font-weight: 600;
    color: ${success.text};
}
QLabel#DeliveryStatus[status="failed"] {
    font-weight: 600;
    color: ${danger.text};
}

/* ============================================
   CAGES VISUALIZATION TAB
   ============================================ */

/* The tab's title, and the hint at the top of its board card */
QLabel#CagesTitle {
    font-size: 18px;
    font-weight: 700;
    color: ${text.primary};
}
QLabel#CagesSubtitle {
    font-size: 13px;
    font-style: italic;
    color: ${text.secondary};
    padding: 4px 8px;
    background: transparent;
}
/* In place of the board's picture when its file is missing */
QLabel#CagesBoardPlaceholder {
    font-size: 14px;
    color: ${text.muted};
}

/* Board title - centered, subtle */
QLabel#BoardTitle {
    font-size: 12px;
    font-weight: 500;
    color: ${text.muted};
    background: transparent;
    padding: 4px 0;
}

/* Column headers - uppercase, subtle */
QLabel#ColumnHeader {
    font-size: 10px;
    font-weight: 600;
    color: ${text.muted};
    text-transform: uppercase;
    letter-spacing: 0.8px;
    background: transparent;
    padding: 6px 0;
}

/* Relay Terminal Widget - cage type */
QFrame#RelayTerminal {
    background: ${bg.surface};
    border: 1px solid ${border.subtle};
    border-radius: 4px;
    border-left: 3px solid ${accent.indicator};
}
QFrame#RelayTerminal:hover {
    background: ${bg.hover};
    border-color: ${border.control.hover};
}
QFrame#RelayTerminal[selected="true"] {
    background: ${accent.tint};
    border-color: ${accent.indicator};
}

/* Relay Terminal Widget - master solenoid */
QFrame#MasterTerminal {
    background: ${warning.tint.master-terminal};
    border: 1px solid ${warning.indicator.master-terminal};
    border-radius: 4px;
    border-left: 3px solid ${warning.indicator};
}
QFrame#MasterTerminal:hover {
    background: ${warning.tint};
}
QFrame#MasterTerminal[selected="true"] {
    background: ${warning.tint};
    border-color: ${warning.indicator.selected};
}

/* Inline cage name editor. It shows only while a name is edited, with the focus, and its
   own rule outranks QLineEdit:focus: its 1px focus.ring edge is its focus cue. */
QLineEdit#CageNameEdit {
    background: ${bg.field};
    border: 1px solid ${focus.ring};
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 13px;
    font-weight: 500;
}

/* Relay number badge */
QLabel#RelayNumber {
    font-size: 12px;
    font-weight: 700;
    color: ${text.secondary};
    background: ${bg.inset};
    border-radius: 4px;
    padding: 2px 6px;
}

/* Cage name - primary text */
QLabel#CageNameLabel {
    font-size: 13px;
    font-weight: 500;
    color: ${text.primary};
    background: transparent;
}

/* Master label - amber accent */
QLabel#MasterLabel {
    font-size: 12px;
    font-weight: 700;
    color: ${warning.on-tint.master-terminal};
    background: transparent;
}

/* Unassigned relay */
QLabel#UnassignedLabel {
    font-size: 12px;
    color: ${text.muted};
    background: transparent;
}

/* Status indicator dots */
QLabel#StatusDot {
    font-size: 10px;
    color: ${accent.indicator};
    background: transparent;
}

QLabel#MasterStatusDot {
    font-size: 10px;
    color: ${warning.indicator.status-dot};
    background: transparent;
}

QLabel#StatusLabel {
    font-size: 12px;
    color: ${text.secondary};
    background: transparent;
}

QLabel#HealthIndicator {
    font-size: 11px;
    color: ${text.muted};
    background: transparent;
}

QLabel#TimeRemaining {
    font-size: 11px;
    color: ${text.muted};
    font-style: italic;
    background: transparent;
}

/* ============================================
   WIZARD LOG
   ============================================ */
QTextEdit#WizardLog {
    background: ${bg.inset};
    border: 1px solid ${border.subtle};
    border-radius: 8px;
    font-family: "IBM Plex Mono", "SF Mono", Monaco, monospace;
    font-size: 12px;
    padding: 12px;
}

QLabel#ChecklistItem {
    padding: 8px 4px;
}

/* ============================================
   TABLE ACTION BAR
   ============================================ */
QWidget#TableActionBar {
    padding: 12px 0;
}

/* ============================================
   CHECKBOXES
   ============================================ */
QCheckBox {
    spacing: 8px;
    color: ${text.primary};
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid ${border.control};
    border-radius: 4px;
    background: ${bg.field};
}
QCheckBox::indicator:hover {
    border-color: ${border.control.hover};
}
QCheckBox::indicator:checked {
    background: ${accent.fill};
    border-color: ${accent.fill};
}
QCheckBox::indicator:disabled {
    background: ${bg.disabled};
    border-color: ${border.subtle};
}

/* ============================================
   RADIO BUTTONS
   ============================================ */
QRadioButton {
    spacing: 8px;
    color: ${text.primary};
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid ${border.control};
    border-radius: 9px;
    background: ${bg.field};
}
QRadioButton::indicator:hover {
    border-color: ${border.control.hover};
}
QRadioButton::indicator:checked {
    background: ${accent.fill};
    border-color: ${accent.fill};
}

/* ============================================
   TOOLTIPS
   ============================================ */
QToolTip {
    background: ${bg.tooltip};
    color: ${text.tooltip};
    border: none;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 12px;
}

/* ============================================
   MENU BAR
   ============================================ */
QMenuBar {
    background: ${bg.surface};
    border-bottom: 1px solid ${border.subtle};
    padding: 4px 8px;
}
QMenuBar::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: ${text.primary};
}
QMenuBar::item:selected {
    background: ${bg.selected};
    color: ${text.on-accent};
}
QMenu {
    background: ${bg.surface};
    border: 1px solid ${border.subtle};
    border-radius: 8px;
    padding: 8px;
}
QMenu::item {
    padding: 10px 24px;
    border-radius: 4px;
    color: ${text.primary};
}
/* An item rule with a colour also colours disabled items: grey them out again. */
QMenu::item:disabled {
    color: ${text.disabled};
}
QMenu::item:selected {
    background: ${bg.selected};
    color: ${text.on-accent};
}

/* ============================================
   SLIDERS
   ============================================ */
QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: ${bg.track};
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: ${accent.indicator};
    border: none;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}
QSlider::handle:horizontal:hover {
    background: ${accent.fill.hover};
}
QSlider::sub-page:horizontal {
    background: ${accent.indicator};
    border-radius: 3px;
}

/* ============================================
   WIZARD COMPONENTS
   ============================================ */

/* Wizard Step Circle */
QLabel#WizardStepCircle {
    font-size: 14px;
    font-weight: 600;
    border-radius: 18px;
    border: 2px solid ${border.control};
    background: ${bg.surface};
    color: ${text.secondary};
}
QLabel#WizardStepCircle[state="completed"] {
    border-color: ${accent.fill};
    background: ${accent.fill};
    color: ${text.on-accent};
}
QLabel#WizardStepCircle[state="current"] {
    border-color: ${accent.indicator};
    background: ${accent.tint};
    color: ${text.accent};
}
QLabel#WizardStepCircle[state="pending"] {
    border-color: ${border.control};
    background: ${bg.surface};
    color: ${text.muted};
}

/* Wizard Step Title */
QLabel#WizardStepTitle {
    font-size: 11px;
    color: ${text.muted};
    padding: 0 8px;
}
QLabel#WizardStepTitle[state="completed"] {
    color: ${text.accent};
}
QLabel#WizardStepTitle[state="current"] {
    color: ${text.primary};
    font-weight: 600;
}

/* Wizard Connector Line */
QFrame#WizardConnector {
    background: ${border.subtle};
    border: none;
}
QFrame#WizardConnector[state="completed"] {
    background: ${accent.indicator};
}

/* Wizard Separator: an HLine. Without a border Qt draws no line of its own (a Plain HLine
   drew one in WindowText, near-black, 3px tall): 1px of the divider */
QFrame#WizardSeparator {
    background: ${border.divider};
    border: none;
    min-height: 1px;
    max-height: 1px;
}
/* The rule widget for every other divider (ui.components.card.Divider: NoFrame, its 1px
   size fixed in code) */
QFrame#Divider {
    background: ${border.divider};
    border: none;
}

/* Wizard Navigation Buttons */
QPushButton#WizardBackButton {
    background: ${bg.surface};
    border: 1px solid ${border.control};
    border-radius: 4px;
    color: ${text.secondary};
    padding: 12px 20px;
    font-size: 14px;
    font-weight: 500;
}
QPushButton#WizardBackButton:hover {
    background: ${bg.hover};
    border-color: ${border.control.hover};
    color: ${text.primary};
}
QPushButton#WizardNextButton {
    background: ${accent.fill};
    border: none;
    border-radius: 4px;
    color: ${text.on-accent};
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
}
QPushButton#WizardNextButton:hover {
    background: ${accent.fill.hover};
}
QPushButton#WizardNextButton:disabled {
    background: ${bg.disabled};
    color: ${text.disabled};
}
/* Start Over, beside the steps: a default button, smaller. Its own 1px border outranks
   QPushButton:focus, so focus does not thicken it, as before v2.1.0. */
QPushButton#WizardStartOverButton {
    border: 1px solid ${border.control};
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: 500;
}

/* ============================================
   INTERACTIVE CARD COMPONENT
   ============================================ */
QFrame#InteractiveCard {
    background: ${bg.surface};
    border: 1px solid ${border.subtle};
    border-radius: 8px;
    padding: 16px;
}
QFrame#InteractiveCard:hover {
    border-color: ${border.control.hover};
    background: ${bg.hover};
}
/* Checked: a 2px accent border; the padding gives the extra pixel back, so nothing moves */
QFrame#InteractiveCard[checked="true"] {
    border: 2px solid ${accent.indicator};
    padding: 15px;
    background: ${accent.tint};
}

/* Card Icon */
QLabel#CardIcon {
    font-size: 20px;
    color: ${text.accent};
    background: ${accent.tint};
    border-radius: 4px;
}

/* Card Title */
QLabel#CardTitle {
    font-size: 16px;
    font-weight: 600;
    color: ${text.primary};
}

/* Card Description */
QLabel#CardDescription {
    font-size: 13px;
    color: ${text.secondary};
    line-height: 1.4;
}

/* Card Badge */
QLabel#CardBadge {
    font-size: 11px;
    font-weight: 500;
    color: ${text.accent};
    background: ${accent.tint};
    border-radius: 4px;
    padding: 4px 8px;
}

/* ============================================
   WIZARD STEP CONTENT AREA
   ============================================ */
/* Step Header */
QLabel#StepIcon {
    font-size: 24px;
    color: ${text.accent};
}
QLabel#StepTitle {
    font-size: 22px;
    font-weight: 600;
    color: ${text.primary};
}
QLabel#StepDescription {
    font-size: 14px;
    color: ${text.secondary};
}

/* ============================================
   SCHEDULE WIZARD STEPS
   ============================================ */
/* Step 2's banner: how many animals the relays allow. The warning tint, with a 1px edge
   all round. */
QFrame#WizardLimitBanner {
    background: ${warning.tint};
    border: 1px solid ${warning.indicator};
    border-radius: 4px;
}
/* A QLabel is a QFrame: before v2.1.0 the banner's own `QFrame {...}` sheet also framed its
   icon and its text. That 1px border stays, transparent, so neither moves; removing it is
   a layout change for later. */
QFrame#WizardLimitBanner QLabel {
    border: 1px solid transparent;
}
QLabel#WizardLimitText {
    color: ${warning.on-tint};
    font-size: 11px;
}

/* Step 2's count of selected animals: muted at 11px until the selection first changes,
   then 12px in the colour of the count (count="none"|"some"|"over") */
QLabel#WizardSelectionCounter {
    color: ${text.muted};
    font-size: 11px;
}
QLabel#WizardSelectionCounter[count="none"],
QLabel#WizardSelectionCounter[count="some"],
QLabel#WizardSelectionCounter[count="over"] {
    font-size: 12px;
}
QLabel#WizardSelectionCounter[count="some"] {
    color: ${success.text};
}
QLabel#WizardSelectionCounter[count="over"] {
    color: ${danger.text};
}

/* Step 3 with no animals selected */
QLabel#WizardEmptyState {
    color: ${text.muted};
    font-size: 14px;
}

/* Step 3's row for each animal (the schedule edit dialog's too): a list row under a rule
   in its group box, not a box inside the box */
QFrame#AnimalConfigRow {
    background: transparent;
    border: none;
    border-bottom: 1px solid ${border.divider};
    border-radius: 0;
    padding: 8px 0;
    margin: 0;
}

/* Step 4's summary, on the page: section titles with a rule under them, then label and
   value rows */
QLabel#WizardSummarySection {
    font-size: 12px;
    font-weight: 600;
    color: ${text.accent};
    padding-top: 6px;
    padding-bottom: 4px;
    border-bottom: 1px solid ${border.divider};
}
QLabel#WizardSummaryLabel {
    font-size: 11px;
    font-weight: 500;
    color: ${text.secondary};
}
QLabel#WizardSummaryValue {
    font-size: 11px;
    font-weight: 600;
    color: ${text.primary};
}

/* ============================================
   SPLASH SCREEN
   ============================================ */
/* On the splash's teal gradient, which SplashScreen paints from accent.fill to
   accent.fill.hover: the title and the status (an error too, which its words name) in
   text.on-accent, and the bar in it over a deeper teal groove */
QLabel#SplashTitle, QLabel#SplashStatus {
    color: ${text.on-accent};
}
QProgressBar#SplashProgress {
    background: ${accent.fill.pressed};
    border: none;
    border-radius: 4px;
    /* No outline: 8px tall, as before v2.1.0 */
    min-height: 8px;
    max-height: 8px;
}
QProgressBar#SplashProgress::chunk {
    background: ${text.on-accent};
    border-radius: 4px;
}

/* ============================================
   HELP TAB
   ============================================ */

/* Sidebar: the navigation column on the base layer, as WinUI's NavigationView pane; one
   stroke divides it from the content. Its outer corners follow the pane's (its radius less
   its 1px border), so its square corners do not cover the pane's rounded ones. */
QWidget#HelpSidebar {
    background-color: ${bg.page};
    border-right: 1px solid ${border.subtle};
    border-top-left-radius: 7px;
    border-bottom-left-radius: 7px;
}

/* Content pane container */
QWidget#HelpContentPane {
    background-color: ${bg.surface};
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
}

/* Topic tree: straight on the sidebar, no box of its own */
QTreeWidget#HelpTree {
    background-color: transparent;
    border: none;
    outline: none;
    color: ${text.primary};
    /* The selection is the rounded item alone, not a second block in the indent */
    show-decoration-selected: 0;
}
QTreeWidget#HelpTree::item {
    padding: 8px 10px;
    border-radius: 4px;
    margin: 1px 2px;
    color: ${text.primary};
}
QTreeWidget#HelpTree::item:hover {
    background-color: ${bg.hover};
}
QTreeWidget#HelpTree::item:selected {
    background-color: ${bg.selected};
    color: ${text.on-accent};
    font-weight: 500;
}
QTreeWidget#HelpTree::branch {
    background: transparent;
}
QTreeWidget#HelpTree::branch:has-children:!has-siblings:closed,
QTreeWidget#HelpTree::branch:closed:has-children:has-siblings {
    background: transparent;
}
QTreeWidget#HelpTree::branch:open:has-children:!has-siblings,
QTreeWidget#HelpTree::branch:open:has-children:has-siblings {
    background: transparent;
}

/* Breadcrumb */
QLabel#HelpBreadcrumb {
    color: ${text.secondary};
    font-size: 12px;
    padding: 6px 4px;
    background: transparent;
}

/* Result count caption */
QLabel#HelpResultCount {
    color: ${text.muted};
    font-size: 11px;
    padding: 2px 4px;
    background: transparent;
}

/* Content browser — override QTextEdit form-input rules. Its text colours come from
   the Help page's own HTML. */
/* No box: the content pane is the box. Its viewport is square and a stylesheet radius
   cannot round it, so a margin keeps it off the pane's rounded bottom-right corner. */
QTextBrowser#HelpContent {
    background-color: ${bg.surface};
    border: none;
    border-radius: 0;
    padding: 0;
    margin: 0px 4px 4px 0px;
}
QTextBrowser#HelpContent:focus {
    border: none;
    padding: 0;
}
