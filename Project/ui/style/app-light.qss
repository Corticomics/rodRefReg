/* GENERATED by build_qss.py from app.qss.tmpl and tokens.py — do not edit. */
/*
 * Rodent Refreshment Regulator - Light Theme
 *
 * Grey page, white cards and fields, borders that show, teal accent: the robust-contrast
 * palette (v2.1.0). Every colour is a role in Project/ui/style/tokens.py, and
 * Project/tests/unit/test_theme_contrast.py checks the pairs the UI draws, in both themes.
 *
 * Base colours come from the QPalette StyleManager builds from the same tokens (window,
 * text, fields, placeholders, alternate rows, selection, links). The rules below set
 * surfaces, borders and the colours that differ from those.
 */

/* ============================================
   GLOBAL DEFAULTS
   ============================================ */
* {
    font-family: "IBM Plex Sans", "SF Pro Display", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 13px;
    outline: none;
}

/* No universal QWidget background or colour: the window and dialogs paint the
   palette's Window (bg.page), and plain containers stay transparent, so a container
   inside a card shows the card. A `color` on any rule that matches an input would
   make Qt draw its placeholder at half alpha, below 4.5:1; inputs take their text and
   placeholder colours from the palette. */

/* A scroll area's viewport and content widget fill themselves with the palette's
   Window, which would paint the page colour inside a card: they show what the scroll
   area sits on (the QScrollArea rule reaches its viewport). Stacked pages do too. */
QScrollArea, QScrollArea > QWidget > QWidget, QStackedWidget {
    background: transparent;
}

/* ============================================
   CARDS & ELEVATED SURFACES
   ============================================ */
QFrame#Card, QFrame[card="true"] {
    background: #FFFFFF;
    border: 1px solid #AAB2BE;
    border-radius: 12px;
    padding: 0;
}

/* Logged-out login prompt: the card surface instead of the page */
QWidget#LoginGatePrompt, QWidget#LoginGatePrompt QLabel {
    background-color: #FFFFFF;
}

/* Labels are transparent by default so they blend into whatever surface they
   sit on (e.g. Cards) rather than painting the page as a box.
   objectName-styled labels (banners, etc.) override this. */
QLabel {
    background: transparent;
}

/* ============================================
   TYPOGRAPHY HELPERS
   ============================================ */
QLabel#Headline {
    font-size: 24px;
    font-weight: 600;
    color: #1A1D1F;
}
QLabel#Title {
    font-size: 18px;
    font-weight: 500;
    color: #1A1D1F;
}
QLabel#Subtitle, QLabel#Subheader {
    font-size: 14px;
    font-weight: 400;
    color: #2E3A4B;
    padding: 4px 0;
}
QLabel#Caption {
    font-size: 11px;
    color: #475366;
}

/* ============================================
   FORM INPUTS
   ============================================ */
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #FFFFFF;
    border: 1px solid #626E7E;
    border-radius: 8px;
    padding: 10px 12px;
    selection-background-color: #0F766E;
    selection-color: #FFFFFF;
}
QComboBox { 
    min-height: 36px;
    padding-right: 28px;
    /* Use the classic popup that sizes to fit all items. With a stylesheet Qt
       switches to a scrollable popup whose height is computed from the font
       row height, not the styled (min-height + padding) row height, so the last
       item gets clipped behind a scroll arrow. */
    combobox-popup: 0;
}
QLineEdit:hover, QPlainTextEdit:hover, QTextEdit:hover, 
QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border-color: #475569;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, 
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 2px solid #0F766E;
    padding: 9px 11px;
    background: #FFFFFF;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background: #ECEEF1;
    color: #7B8490;
    border-color: #AAB2BE;
}

/* Placeholder text is the palette's PlaceholderText (text.muted): no rule here. */

/* ComboBox dropdown */
QComboBox::drop-down {
    border: none;
    width: 24px;
    padding-right: 8px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #2E3A4B;
}
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #AAB2BE;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #0F766E;
    selection-color: #FFFFFF;
}
QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 6px 10px;
    border-radius: 6px;
    color: #1A1D1F;
}
QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background: #0F766E;
    color: #FFFFFF;
}

/* SpinBox buttons */
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: transparent;
    border: none;
    width: 20px;
}

/* ============================================
   BUTTONS - Default
   ============================================ */
QPushButton {
    background: #FFFFFF;
    border: 1px solid #626E7E;
    border-radius: 8px;
    padding: 10px 20px;
    min-height: 40px;
    font-weight: 500;
    color: #1A1D1F;
}
QPushButton:hover { 
    background: #E6E9ED;
    border-color: #475569;
}
QPushButton:pressed {
    background: #C3C7CD;
    border-color: #475569;
}
QPushButton:disabled {
    background: #ECEEF1;
    color: #7B8490;
    border-color: #AAB2BE;
}
QPushButton:focus {
    border: 2px solid #0F766E;
    padding: 9px 19px;
}

/* Compact buttons for tables */
QTableWidget QPushButton {
    padding: 6px 12px;
    min-height: 28px;
    max-height: 32px;
    font-size: 12px;
    border-radius: 6px;
}

/* Info Button - Circular help icon */
QPushButton#InfoButton {
    background-color: #0F766E;
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
    font-size: 14px;
    font-weight: 700;
}
QPushButton#InfoButton:hover {
    background-color: #115E59;
}
QPushButton#InfoButton:pressed {
    background-color: #134E4A;
}

QPushButton#CompactButton {
    padding: 8px 12px;
    min-height: 32px;
    max-height: 36px;
    font-size: 12px;
}

/* ============================================
   BUTTONS - Primary (Teal)
   ============================================ */
QPushButton[variant="primary"] {
    background: #0F766E;
    border: 1px solid #0F766E;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton[variant="primary"]:hover {
    background: #115E59;
    border-color: #115E59;
}
QPushButton[variant="primary"]:pressed {
    background: #134E4A;
    border-color: #134E4A;
}
/* Greyed out like every other disabled button */
QPushButton[variant="primary"]:disabled {
    background: #ECEEF1;
    border-color: #AAB2BE;
    color: #7B8490;
}
QPushButton[variant="primary"]:focus {
    border: 2px solid #042F2E;
}

/* ============================================
   BUTTONS - Danger
   ============================================ */
QPushButton[variant="danger"] {
    background: #DC2626;
    border: 1px solid #DC2626;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton[variant="danger"]:hover {
    background: #B91C1C;
    border-color: #B91C1C;
}
QPushButton[variant="danger"]:pressed {
    background: #991B1B;
    border-color: #991B1B;
}
/* Greyed out like every other disabled button: the red alone must not say
   "press me" when the control is unavailable (CLOSE ALL RELAYS and Log Out
   while a schedule runs, Close Master while the master is closed). */
QPushButton[variant="danger"]:disabled {
    background: #ECEEF1;
    border-color: #AAB2BE;
    color: #7B8490;
}

/* ============================================
   TABS
   ============================================ */
QTabWidget::pane {
    border: 1px solid #AAB2BE;
    border-radius: 12px;
    background: #DADDE2;
    margin-top: -1px;
}
QTabBar::tab {
    background: #C3C7CD;
    border: 1px solid #AAB2BE;
    border-bottom: none;
    padding: 8px 16px;
    min-width: 70px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 2px;
    font-size: 12px;
    font-weight: 500;
    color: #2E3A4B;
}
QTabBar::tab:hover {
    background: #CFD2D7;
    color: #1A1D1F;
}
/* The selected tab joins its pane, and a 3px accent bar on top marks it: the bar is
   3:1 or more against the pane and the rail, so the state is not carried by a
   colour step alone. The bar takes 2px of the top padding, so no tab moves. */
QTabBar::tab:selected {
    background: #DADDE2;
    border-bottom-color: #DADDE2;
    border-top: 3px solid #0F766E;
    padding-top: 6px;
    color: #1A1D1F;
    font-weight: 600;
}
/* Ensure tab bar doesn't scroll prematurely */
QTabBar {
    qproperty-expanding: false;
}

/* ============================================
   TABLES
   ============================================ */
/* The header widget and its corner paint the palette's Window, not the section rule:
   transparent, they show the table's own surface. */
QHeaderView {
    background: transparent;
}
QHeaderView::section {
    background: #DADDE2;
    border: none;
    border-bottom: 2px solid #AAB2BE;
    padding: 12px 16px;
    font-weight: 600;
    color: #2E3A4B;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.5px;
}
QTableCornerButton::section {
    background: #DADDE2;
    border: none;
    border-bottom: 2px solid #AAB2BE;
}
QTableView, QTableWidget {
    background: #FFFFFF;
    alternate-background-color: #F1F3F5;
    border: 1px solid #AAB2BE;
    border-radius: 12px;
    gridline-color: #CDD1D7;
    selection-background-color: #0F766E;
    selection-color: #FFFFFF;
    color: #1A1D1F;
}
QTableView::item, QTableWidget::item {
    padding: 12px 16px;
    border-bottom: 1px solid #CDD1D7;
}
/* Hover first: a selected row under the pointer keeps the selection colours. */
QTableView::item:hover, QTableWidget::item:hover {
    background: #E6E9ED;
}
QTableView::item:selected, QTableWidget::item:selected {
    background: #0F766E;
    color: #FFFFFF;
}

/* Animals tab: the "Last schedule delivered amount" cell of a run that ended short
   (Stopped, Incomplete, Interrupted) is filled with alertFill and written in alertText,
   bold, by AnimalsTab's delegate: the same bright red in both themes, with white text
   at 4.83:1. The cell's text starts with its status word, so the red is not the only
   cue. */
QWidget#AnimalsTab {
    qproperty-alertFill: #DC2626;
    qproperty-alertText: #FFFFFF;
}

/* ============================================
   CALENDAR POPUP
   ============================================ */
/* A date field's calendar fills its navigation bar with the palette's Highlight and
   writes the month and year in HighlightedText: a solid teal band. The bar is the inset
   surface instead, the page colour it had before v2.1.0, under body text. Its days are
   a table (the rules above and the palette: Base, AlternateBase for the weekday row,
   Highlight for the chosen day). */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #DADDE2;
}
QCalendarWidget QToolButton {
    color: #1A1D1F;
}

/* ============================================
   PROGRESS BARS
   ============================================ */
QProgressBar {
    border: none;
    border-radius: 8px;
    text-align: center;
    background: #DADDE2;
    min-height: 8px;
    max-height: 8px;
}
QProgressBar::chunk {
    background: #0F766E;
    border-radius: 8px;
}

/* ============================================
   GROUP BOXES (Cards)
   ============================================ */
QGroupBox {
    background: #FFFFFF;
    border: 1px solid #AAB2BE;
    border-radius: 12px;
    margin-top: 24px;
    margin-bottom: 8px;
    padding: 24px 20px 20px 20px;
    color: #1A1D1F;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px;
    top: 8px;
    padding: 0 8px;
    color: #1A1D1F;
    font-weight: 600;
    font-size: 14px;
    background: transparent;
}

/* Nested GroupBox */
QGroupBox QGroupBox {
    background: #DADDE2;
    border: 1px solid #AAB2BE;
    border-radius: 8px;
    margin-top: 20px;
    padding: 20px 16px 16px 16px;
}
QGroupBox QGroupBox::title {
    color: #2E3A4B;
    font-weight: 500;
    font-size: 12px;
}

/* ============================================
   LISTS
   ============================================ */
QListWidget {
    background: #FFFFFF;
    alternate-background-color: #F1F3F5;
    border: 1px solid #AAB2BE;
    border-radius: 8px;
    padding: 8px;
    color: #1A1D1F;
}
QListWidget::item { 
    padding: 10px 12px;
    border-radius: 6px;
    margin: 2px 0;
}
QListWidget::item:hover {
    background: #E6E9ED;
}
QListWidget::item:selected {
    background: #0F766E;
    color: #FFFFFF;
    font-weight: 500;
}

/* ============================================
   SCROLLBARS (Minimal)
   ============================================ */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px;
}
QScrollBar::handle:vertical {
    background: #626E7E;
    border-radius: 4px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover {
    background: #475569;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 2px 4px;
}
QScrollBar::handle:horizontal {
    background: #626E7E;
    border-radius: 4px;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover {
    background: #475569;
}
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page { 
    background: transparent;
    width: 0; 
    height: 0; 
}

/* ============================================
   DROP AREAS
   ============================================ */
QWidget#DropArea[state="idle"] {
    background: #FFFFFF;
    border: 2px dashed #626E7E;
    border-radius: 12px;
}
QWidget#DropArea[state="drag"] {
    background: #CCFBF1;
    border: 2px solid #0F766E;
    border-radius: 12px;
}

/* ============================================
   STATUS INDICATORS
   ============================================ */
QLabel[variant="warning"] {
    background: #FEF3C7;
    color: #92400E;
    padding: 12px 16px;
    border-radius: 8px;
    border-left: 4px solid #F59E0B;
}
QLabel[variant="success"] {
    background: #D1FAE5;
    color: #065F46;
    padding: 12px 16px;
    border-radius: 8px;
    border-left: 4px solid #10B981;
}
QLabel[variant="error"] {
    background: #FEE2E2;
    color: #991B1B;
    padding: 12px 16px;
    border-radius: 8px;
    border-left: 4px solid #EF4444;
}
QLabel[variant="info"] {
    background: #E0F2FE;
    color: #0C4A6E;
    padding: 12px 16px;
    border-radius: 8px;
    border-left: 4px solid #0284C7;
}

/* ============================================
   USER TAB STYLES
   ============================================ */
QLabel#InfoBanner {
    background: #CCFBF1;
    color: #115E59;
    padding: 12px 16px;
    border-radius: 8px;
    border-left: 4px solid #0F766E;
}
QLabel#ProfileWelcome {
    font-size: 18px;
    font-weight: 600;
    padding: 8px 0;
    color: #1A1D1F;
}
QLabel#LinkLabel {
    color: #115E59;
    font-size: 12px;
}
QLabel#LinkLabel:hover {
    text-decoration: underline;
}

/* ============================================
   HELP TEXT
   ============================================ */
QLabel#HelpText {
    color: #2E3A4B;
    font-size: 12px;
    padding: 4px 0;
    line-height: 1.5;
}

/* ============================================
   SETTINGS
   ============================================ */
/* A group box's one-line description (General > User Mode) */
QLabel#GroupDescription {
    color: #2E3A4B;
    font-size: 11px;
}

/* General > Slack Integration > Status: the colour of the last message's fate, which its
   words also give (Delivered at, Failed at, Status unknown) */
QLabel#SlackStatus {
    color: #475366;
    padding: 6px;
    border-radius: 4px;
}
QLabel#SlackStatus[status="ok"] {
    color: #065F46;
}
QLabel#SlackStatus[status="warn"] {
    color: #92400E;
}

/* ============================================
   PRIMING STATUS
   ============================================ */
QLabel#StatusLabel {
    border-radius: 8px;
    padding: 10px 16px;
    font-weight: 600;
    font-size: 13px;
}
QLabel#StatusLabel[status="closed"] {
    background: #DADDE2;
    color: #2E3A4B;
}
QLabel#StatusLabel[status="open"] {
    background: #0F766E;
    color: #FFFFFF;
}

/* ============================================
   FORM LAYOUTS
   ============================================ */
QGroupBox QLabel {
    background: transparent;
    color: #1A1D1F;
}
QFormLayout > QLabel {
    min-width: 160px;
    padding-right: 12px;
    color: #2E3A4B;
    font-weight: 500;
}

/* ============================================
   SCHEDULES HUB
   ============================================ */
QLabel#SchedulesHubTitle {
    font-size: 16px;
    font-weight: 700;
    color: #1A1D1F;
}

/* The header's buttons are smaller than the app's. Their own border (1px, or none)
   outranks QPushButton:focus, so focus does not thicken it, as before v2.1.0. */
/* Select is a default button. It reads Cancel in select mode, in the danger tint. */
QPushButton#SchedulesHubSelect {
    border: 1px solid #626E7E;
    border-radius: 6px;
    padding: 5px 12px;
    font-weight: 500;
    font-size: 11px;
}
QPushButton#SchedulesHubSelect[selecting="true"] {
    background: #FEE2E2;
    border-color: #FECACA;
    color: #991B1B;
}
QPushButton#SchedulesHubSelect[selecting="true"]:hover {
    background: #FECACA;
}
/* Edit Schedule, Delete Selected, + New Schedule and the empty state's Create Schedule
   take their colours from QPushButton[variant="primary"] and [variant="danger"] */
QPushButton#SchedulesHubEdit, QPushButton#SchedulesHubDelete, QPushButton#SchedulesHubNew {
    border: none;
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 11px;
}
QPushButton#SchedulesHubEdit, QPushButton#SchedulesHubDelete {
    font-weight: 500;
}
QPushButton#SchedulesHubNew {
    font-weight: 600;
}
QPushButton#SchedulesHubCreate {
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: 600;
}

/* The search field keeps its 1px frame when focused, with the focus colour */
QLineEdit#SchedulesHubSearch {
    border: 1px solid #626E7E;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    background: #FFFFFF;
}
QLineEdit#SchedulesHubSearch:focus {
    border-color: #0F766E;
}

QLabel#SchedulesHubEmptyTitle {
    font-size: 14px;
    font-weight: 600;
    color: #2E3A4B;
}
QLabel#SchedulesHubEmptyText {
    font-size: 12px;
    color: #475366;
}

/* A schedule card. In select mode a selected card (selected="true") is tinted, with a
   2px border; its rule comes after :hover, so it keeps that look under the pointer. */
QFrame#ScheduleCard {
    background: #FFFFFF;
    border: 1px solid #AAB2BE;
    border-radius: 10px;
}
QFrame#ScheduleCard:hover {
    background: #E6E9ED;
    border-color: #475569;
}
QFrame#ScheduleCard[selected="true"] {
    background: #CCFBF1;
    border: 2px solid #0F766E;
}
QLabel#ScheduleCardName {
    font-size: 13px;
    font-weight: 600;
    color: #1A1D1F;
    background: transparent;
}
QLabel#ScheduleCardMeta {
    font-size: 11px;
    color: #2E3A4B;
    background: transparent;
}
QLabel#ScheduleCardHint {
    font-size: 9px;
    color: #475366;
    background: transparent;
}
QLabel#ScheduleCardCreated {
    font-size: 9px;
    font-weight: 500;
    color: #115E59;
    background: transparent;
}
/* The delivery mode: Staggered in the accent, Instant in indigo; the word names it */
QLabel#ScheduleModeBadge {
    border-radius: 10px;
    font-weight: 600;
    font-size: 9px;
    padding: 3px 8px;
}
QLabel#ScheduleModeBadge[mode="staggered"] {
    background: #0F766E;
    color: #FFFFFF;
}
QLabel#ScheduleModeBadge[mode="instant"] {
    background: #4F46E5;
    color: #FFFFFF;
}
/* A card's context menu: tighter than the app's menus, in their colours */
QMenu#ScheduleCardMenu {
    border-radius: 6px;
    padding: 4px;
}
QMenu#ScheduleCardMenu::item {
    padding: 8px 16px;
    border-radius: 4px;
}

/* ============================================
   SCHEDULE PROGRESS TRACKER
   ============================================ */

/* Header frame */
QFrame#TrackerHeader {
    background-color: #FFFFFF;
    border: 1px solid #AAB2BE;
    border-radius: 12px;
    padding: 12px;
}

QLabel#ScheduleTitle {
    font-size: 16px;
    font-weight: 600;
    color: #1A1D1F;
    background: transparent;
}

QLabel#ElapsedTime {
    font-size: 14px;
    font-weight: 500;
    color: #115E59;
    background: #CCFBF1;
    padding: 6px 12px;
    border-radius: 16px;
}

QScrollArea#TrackerScrollArea {
    background-color: transparent;
    border: none;
}

/* Material Cards: one per animal */
QFrame#MaterialCard {
    background-color: #FFFFFF;
    border: 1px solid #AAB2BE;
    border-radius: 12px;
    padding: 0;
}
/* A QLabel is a QFrame. Before v2.1.0 the card's own `QFrame {...}` sheet also gave every
   label in it a 1px border: it drew a box around each, and QLabel indents the text of a
   framed label by half an "x". The border stays, transparent, so no label moves; removing
   it is a layout change for later. */
QFrame#MaterialCard QLabel {
    border: 1px solid transparent;
}

QLabel#CardTitle {
    font-size: 15px;
    font-weight: 600;
    color: #1A1D1F;
    background: transparent;
}

QLabel#TrackerAnimal {
    font-size: 13px;
    font-weight: 600;
    color: #1A1D1F;
}

QLabel#CageBadge {
    background-color: #0F766E;
    color: #FFFFFF;
    padding: 5px 10px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 11px;
}

/* The animal's progress. The bar writes its value inside it in one colour, over the
   groove and the fill alike: each fill is a shade text.primary reads on (tokens.py,
   progress.*). A complete or failed bar keeps its state (state="complete"|"failed"). */
QProgressBar#TrackerProgress {
    border: 1px solid #AAB2BE;
    border-radius: 11px;
    background: #DADDE2;
    text-align: center;
    font-size: 11px;
    font-weight: 500;
    color: #1A1D1F;
}
QProgressBar#TrackerProgress::chunk {
    border-radius: 10px;
    background: #14B8A6;
}
QProgressBar#TrackerProgress[state="complete"] {
    background: #D1FAE5;
}
QProgressBar#TrackerProgress[state="complete"]::chunk {
    background: #10B981;
}
QProgressBar#TrackerProgress[state="failed"] {
    background: #FEE2E2;
}
QProgressBar#TrackerProgress[state="failed"]::chunk {
    background: #F87171;
}

QLabel#VolumeLabel {
    font-size: 12px;
    font-weight: 600;
    color: #1A1D1F;
    background: transparent;
}

/* The status word: muted and regular until the card's first update, then bold in its
   status's colour. Waiting, and a word with no colour of its own (Incomplete: "other"),
   stay muted. */
QLabel#DeliveryStatus {
    font-size: 11px;
    color: #475366;
}
QLabel#DeliveryStatus[status="waiting"],
QLabel#DeliveryStatus[status="other"] {
    font-weight: 600;
}
QLabel#DeliveryStatus[status="delivering"] {
    font-weight: 600;
    color: #115E59;
}
QLabel#DeliveryStatus[status="paused"] {
    font-weight: 600;
    color: #92400E;
}
QLabel#DeliveryStatus[status="complete"] {
    font-weight: 600;
    color: #065F46;
}
QLabel#DeliveryStatus[status="failed"] {
    font-weight: 600;
    color: #B91C1C;
}

/* ============================================
   CAGES VISUALIZATION TAB
   ============================================ */

/* The tab's title, and the hint at the top of its board card */
QLabel#CagesTitle {
    font-size: 18px;
    font-weight: 700;
    color: #1A1D1F;
}
QLabel#CagesSubtitle {
    font-size: 13px;
    font-style: italic;
    color: #2E3A4B;
    padding: 4px 8px;
    background: transparent;
}
/* In place of the board's picture when its file is missing */
QLabel#CagesBoardPlaceholder {
    font-size: 14px;
    color: #475366;
}

/* Board title - centered, subtle */
QLabel#BoardTitle {
    font-size: 12px;
    font-weight: 500;
    color: #475366;
    background: transparent;
    padding: 4px 0;
}

/* Column headers - uppercase, subtle */
QLabel#ColumnHeader {
    font-size: 10px;
    font-weight: 600;
    color: #475366;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    background: transparent;
    padding: 6px 0;
}

/* Relay Terminal Widget - cage type */
QFrame#RelayTerminal {
    background: #FFFFFF;
    border: 1px solid #AAB2BE;
    border-radius: 6px;
    border-left: 3px solid #0F766E;
}
QFrame#RelayTerminal:hover {
    background: #E6E9ED;
    border-color: #475569;
}
QFrame#RelayTerminal[selected="true"] {
    background: #CCFBF1;
    border-color: #0F766E;
}

/* Relay Terminal Widget - master solenoid */
QFrame#MasterTerminal {
    background: #FFFBEB;
    border: 1px solid #FCD34D;
    border-radius: 6px;
    border-left: 3px solid #F59E0B;
}
QFrame#MasterTerminal:hover {
    background: #FEF3C7;
}
QFrame#MasterTerminal[selected="true"] {
    background: #FEF3C7;
    border-color: #B45309;
}

/* Inline cage name editor */
QLineEdit#CageNameEdit {
    background: #FFFFFF;
    border: 1px solid #626E7E;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 13px;
    font-weight: 500;
}

/* Relay number badge */
QLabel#RelayNumber {
    font-size: 12px;
    font-weight: 700;
    color: #2E3A4B;
    background: #DADDE2;
    border-radius: 4px;
    padding: 2px 6px;
}

/* Cage name - primary text */
QLabel#CageNameLabel {
    font-size: 13px;
    font-weight: 500;
    color: #1A1D1F;
    background: transparent;
}

/* Master label - amber accent */
QLabel#MasterLabel {
    font-size: 12px;
    font-weight: 700;
    color: #92400E;
    background: transparent;
}

/* Unassigned relay */
QLabel#UnassignedLabel {
    font-size: 12px;
    color: #475366;
    background: transparent;
}

/* Status indicator dots */
QLabel#StatusDot {
    font-size: 10px;
    color: #0F766E;
    background: transparent;
}

QLabel#MasterStatusDot {
    font-size: 10px;
    color: #F59E0B;
    background: transparent;
}

QLabel#StatusLabel {
    font-size: 12px;
    color: #2E3A4B;
    background: transparent;
}

QLabel#HealthIndicator {
    font-size: 11px;
    color: #475366;
    background: transparent;
}

QLabel#TimeRemaining {
    font-size: 11px;
    color: #475366;
    font-style: italic;
    background: transparent;
}

/* ============================================
   WIZARD LOG
   ============================================ */
QTextEdit#WizardLog {
    background: #DADDE2;
    border: 1px solid #AAB2BE;
    border-radius: 8px;
    font-family: "IBM Plex Mono", "SF Mono", Monaco, monospace;
    font-size: 12px;
    padding: 12px;
}

QLabel#ChecklistItem {
    padding: 8px 4px;
}

/* ============================================
   TABLE ACTION BAR
   ============================================ */
QWidget#TableActionBar {
    padding: 12px 0;
}

/* ============================================
   CHECKBOXES
   ============================================ */
QCheckBox {
    spacing: 8px;
    color: #1A1D1F;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #626E7E;
    border-radius: 4px;
    background: #FFFFFF;
}
QCheckBox::indicator:hover {
    border-color: #475569;
}
QCheckBox::indicator:checked {
    background: #0F766E;
    border-color: #0F766E;
}
QCheckBox::indicator:disabled {
    background: #ECEEF1;
    border-color: #AAB2BE;
}

/* ============================================
   RADIO BUTTONS
   ============================================ */
QRadioButton {
    spacing: 8px;
    color: #1A1D1F;
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #626E7E;
    border-radius: 9px;
    background: #FFFFFF;
}
QRadioButton::indicator:hover {
    border-color: #475569;
}
QRadioButton::indicator:checked {
    background: #0F766E;
    border-color: #0F766E;
}

/* ============================================
   TOOLTIPS
   ============================================ */
QToolTip {
    background: #1A1D1F;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

/* ============================================
   MENU BAR
   ============================================ */
QMenuBar {
    background: #FFFFFF;
    border-bottom: 1px solid #AAB2BE;
    padding: 4px 8px;
}
QMenuBar::item {
    padding: 8px 12px;
    border-radius: 6px;
    color: #1A1D1F;
}
QMenuBar::item:selected {
    background: #0F766E;
    color: #FFFFFF;
}
QMenu {
    background: #FFFFFF;
    border: 1px solid #AAB2BE;
    border-radius: 8px;
    padding: 8px;
}
QMenu::item {
    padding: 10px 24px;
    border-radius: 6px;
    color: #1A1D1F;
}
/* An item rule with a colour also colours disabled items: grey them out again. */
QMenu::item:disabled {
    color: #7B8490;
}
QMenu::item:selected {
    background: #0F766E;
    color: #FFFFFF;
}

/* ============================================
   SLIDERS
   ============================================ */
QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: #DADDE2;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #0F766E;
    border: none;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}
QSlider::handle:horizontal:hover {
    background: #115E59;
}
QSlider::sub-page:horizontal {
    background: #0F766E;
    border-radius: 3px;
}

/* ============================================
   WIZARD COMPONENTS
   ============================================ */

/* Wizard Step Circle */
QLabel#WizardStepCircle {
    font-size: 14px;
    font-weight: 600;
    border-radius: 18px;
    border: 2px solid #626E7E;
    background: #FFFFFF;
    color: #2E3A4B;
}
QLabel#WizardStepCircle[state="completed"] {
    border-color: #0F766E;
    background: #0F766E;
    color: #FFFFFF;
}
QLabel#WizardStepCircle[state="current"] {
    border-color: #0F766E;
    background: #CCFBF1;
    color: #115E59;
}
QLabel#WizardStepCircle[state="pending"] {
    border-color: #626E7E;
    background: #FFFFFF;
    color: #475366;
}

/* Wizard Step Title */
QLabel#WizardStepTitle {
    font-size: 11px;
    color: #475366;
    padding: 0 8px;
}
QLabel#WizardStepTitle[state="completed"] {
    color: #115E59;
}
QLabel#WizardStepTitle[state="current"] {
    color: #1A1D1F;
    font-weight: 600;
}

/* Wizard Connector Line */
QFrame#WizardConnector {
    background: #AAB2BE;
    border: none;
}
QFrame#WizardConnector[state="completed"] {
    background: #0F766E;
}

/* Wizard Separator */
QFrame#WizardSeparator {
    background: #CDD1D7;
    max-height: 1px;
}

/* Wizard Navigation Buttons */
QPushButton#WizardBackButton {
    background: #FFFFFF;
    border: 1px solid #626E7E;
    border-radius: 10px;
    color: #2E3A4B;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: 500;
}
QPushButton#WizardBackButton:hover {
    background: #E6E9ED;
    border-color: #475569;
    color: #1A1D1F;
}
QPushButton#WizardNextButton {
    background: #0F766E;
    border: none;
    border-radius: 10px;
    color: #FFFFFF;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
}
QPushButton#WizardNextButton:hover {
    background: #115E59;
}
QPushButton#WizardNextButton:disabled {
    background: #ECEEF1;
    color: #7B8490;
}
/* Start Over, beside the steps: a default button, smaller. Its own 1px border outranks
   QPushButton:focus, so focus does not thicken it, as before v2.1.0. */
QPushButton#WizardStartOverButton {
    border: 1px solid #626E7E;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 500;
}

/* ============================================
   INTERACTIVE CARD COMPONENT
   ============================================ */
QFrame#InteractiveCard {
    background: #FFFFFF;
    border: 2px solid #AAB2BE;
    border-radius: 12px;
    padding: 16px;
}
QFrame#InteractiveCard:hover {
    border-color: #475569;
    background: #E6E9ED;
}
QFrame#InteractiveCard[checked="true"] {
    border-color: #0F766E;
    background: #CCFBF1;
}

/* Card Icon */
QLabel#CardIcon {
    font-size: 20px;
    color: #115E59;
    background: #CCFBF1;
    border-radius: 8px;
}

/* Card Title */
QLabel#CardTitle {
    font-size: 16px;
    font-weight: 600;
    color: #1A1D1F;
}

/* Card Description */
QLabel#CardDescription {
    font-size: 13px;
    color: #2E3A4B;
    line-height: 1.4;
}

/* Card Badge */
QLabel#CardBadge {
    font-size: 11px;
    font-weight: 500;
    color: #115E59;
    background: #CCFBF1;
    border-radius: 6px;
    padding: 4px 8px;
}

/* ============================================
   WIZARD STEP CONTENT AREA
   ============================================ */
QWidget#WizardStepContent {
    background: #DADDE2;
    padding: 24px;
}

/* Step Header */
QLabel#StepIcon {
    font-size: 24px;
    color: #115E59;
}
QLabel#StepTitle {
    font-size: 22px;
    font-weight: 600;
    color: #1A1D1F;
}
QLabel#StepDescription {
    font-size: 14px;
    color: #2E3A4B;
}

/* ============================================
   SCHEDULE WIZARD STEPS
   ============================================ */
/* Step 2's banner: how many animals the relays allow. The warning tint, with a 1px edge
   all round. */
QFrame#WizardLimitBanner {
    background: #FEF3C7;
    border: 1px solid #F59E0B;
    border-radius: 6px;
}
/* A QLabel is a QFrame: before v2.1.0 the banner's own `QFrame {...}` sheet also framed its
   icon and its text. That 1px border stays, transparent, so neither moves; removing it is
   a layout change for later. */
QFrame#WizardLimitBanner QLabel {
    border: 1px solid transparent;
}
QLabel#WizardLimitText {
    color: #92400E;
    font-size: 11px;
}

/* Step 2's count of selected animals: muted at 11px until the selection first changes,
   then 12px in the colour of the count (count="none"|"some"|"over") */
QLabel#WizardSelectionCounter {
    color: #475366;
    font-size: 11px;
}
QLabel#WizardSelectionCounter[count="none"],
QLabel#WizardSelectionCounter[count="some"],
QLabel#WizardSelectionCounter[count="over"] {
    font-size: 12px;
}
QLabel#WizardSelectionCounter[count="some"] {
    color: #065F46;
}
QLabel#WizardSelectionCounter[count="over"] {
    color: #B91C1C;
}

/* Step 3 with no animals selected */
QLabel#WizardEmptyState {
    color: #475366;
    font-size: 14px;
}

/* Step 3's row for each animal (the schedule edit dialog's too): outlined in its group
   box */
QFrame#AnimalConfigRow {
    background: #FFFFFF;
    border: 1px solid #AAB2BE;
    border-radius: 8px;
    padding: 8px;
    margin: 4px 0;
}

/* Step 4's summary, on the page: section titles with a rule under them, then label and
   value rows */
QLabel#WizardSummarySection {
    font-size: 12px;
    font-weight: 600;
    color: #115E59;
    padding-top: 6px;
    padding-bottom: 4px;
    border-bottom: 1px solid #AAB2BE;
}
QLabel#WizardSummaryLabel {
    font-size: 11px;
    font-weight: 500;
    color: #2E3A4B;
}
QLabel#WizardSummaryValue {
    font-size: 11px;
    font-weight: 600;
    color: #1A1D1F;
}

/* ============================================
   SPLASH SCREEN
   ============================================ */
/* On the splash's teal gradient, which SplashScreen paints from accent.fill to
   accent.fill.hover: the title and the status (an error too, which its words name) in
   text.on-accent, and the bar in it over a deeper teal groove */
QLabel#SplashTitle, QLabel#SplashStatus {
    color: #FFFFFF;
}
QProgressBar#SplashProgress {
    background: #134E4A;
    border: none;
    border-radius: 4px;
}
QProgressBar#SplashProgress::chunk {
    background: #FFFFFF;
    border-radius: 4px;
}

/* ============================================
   HELP TAB
   ============================================ */

/* Sidebar container */
QWidget#HelpSidebar {
    background-color: #DADDE2;
    border-right: 1px solid #AAB2BE;
}

/* Content pane container */
QWidget#HelpContentPane {
    background-color: #FFFFFF;
}

/* Topic tree */
QTreeWidget#HelpTree {
    background-color: #FFFFFF;
    border: 1px solid #AAB2BE;
    border-radius: 8px;
    outline: none;
    color: #1A1D1F;
    /* The selection is the rounded item alone, not a second block in the indent */
    show-decoration-selected: 0;
}
QTreeWidget#HelpTree::item {
    padding: 8px 10px;
    border-radius: 6px;
    margin: 1px 2px;
    color: #1A1D1F;
}
QTreeWidget#HelpTree::item:hover {
    background-color: #E6E9ED;
}
QTreeWidget#HelpTree::item:selected {
    background-color: #0F766E;
    color: #FFFFFF;
    font-weight: 500;
}
QTreeWidget#HelpTree::branch {
    background: transparent;
}
QTreeWidget#HelpTree::branch:has-children:!has-siblings:closed,
QTreeWidget#HelpTree::branch:closed:has-children:has-siblings {
    background: transparent;
}
QTreeWidget#HelpTree::branch:open:has-children:!has-siblings,
QTreeWidget#HelpTree::branch:open:has-children:has-siblings {
    background: transparent;
}

/* Breadcrumb */
QLabel#HelpBreadcrumb {
    color: #2E3A4B;
    font-size: 12px;
    padding: 6px 4px;
    background: transparent;
}

/* Result count caption */
QLabel#HelpResultCount {
    color: #475366;
    font-size: 11px;
    padding: 2px 4px;
    background: transparent;
}

/* Content browser — override QTextEdit form-input rules. Its text colours come from
   the Help page's own HTML. */
QTextBrowser#HelpContent {
    background-color: #FFFFFF;
    border: 1px solid #AAB2BE;
    border-radius: 8px;
    padding: 0;
    /* Suppress focus thickening inherited from QTextEdit:focus */
}
QTextBrowser#HelpContent:focus {
    border: 1px solid #AAB2BE;
    padding: 0;
}
